<Window x:Class="TypeFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeFlow — Text Expander"
        Width="760" Height="620" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToggleLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + toggles -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="TypeFlow" FontSize="20" FontWeight="Bold" Foreground="#0078D7"/>
                <TextBlock Text="Text Expander" FontSize="13" Foreground="Gray" Margin="8,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Active" Style="{StaticResource ToggleLabel}"/>
                <CheckBox x:Name="ActiveToggle" VerticalAlignment="Center" Margin="0,0,20,0" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                <TextBlock Text="Single-line inputs" Style="{StaticResource ToggleLabel}" ToolTip="Only expands in single-line edit fields (parity with the extension's INPUT toggle)"/>
                <CheckBox x:Name="InputToggle" VerticalAlignment="Center" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
            </StackPanel>
        </Grid>

        <!-- Add / edit form -->
        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8" Background="#FAFAFA">
            <StackPanel>
                <TextBlock x:Name="FormTitle" Text="Add Shortcut" FontWeight="SemiBold" Width="704"/>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Shortcut (e.g., brb)"/>
                        <TextBox x:Name="ShortcutBox" Padding="3" MaxLength="50" Width="704"/>
                        <TextBlock Text="Expansion Text (max 5000 chars)"/>
                        <TextBox x:Name="ExpansionBox" Padding="3" MaxLength="5000" Height="106" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Width="710"/>
                        <Button x:Name="CancelEditButton" Content="Cancel" Padding="12,4" MinWidth="110" Margin="0,4,0,0" Visibility="Collapsed" Click="CancelEditButton_Click"/>
                        <Button x:Name="AddButton" Content="Add Shortcut" Padding="12,6" MinWidth="110" Click="AddButton_Click"/>
                    </StackPanel>
                <TextBlock x:Name="ValidationText" Foreground="#C00000" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Search + list -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="SearchBox" Width="280" Padding="3" ToolTip="Search shortcut or expansion"/>
                <TextBlock x:Name="CountText" Margin="8,4,0,0" Foreground="Gray"/>
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                <ListBox x:Name="ShortcutList" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,62,0,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Shortcut}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Shortcut}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Expansion}" TextTrimming="CharacterEllipsis" Foreground="#444444" ToolTip="{Binding Expansion}" Margin="0,1,0,0"/>
                                <Button Grid.Column="2" Content="✎" Padding="6,1" Margin="0,0,4,0" ToolTip="Edit" Tag="{Binding}" Click="EditButton_Click"/>
                                <Button Grid.Column="3" Content="✕" Padding="6,1" ToolTip="Delete" Tag="{Binding}" Click="DeleteButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Import / export -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Import .CSV…" Padding="12,5" Click="ImportButton_Click"/>
            <Button Content="Export .CSV…" Padding="12,5" Margin="8,0,0,0" Click="ExportButton_Click"/>
            <Button Content="Reset to Defaults" Padding="12,5" Margin="8,0,0,0" Click="ResetButton_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>